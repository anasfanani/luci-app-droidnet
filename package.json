{
  "name": "luci-app-droidnet",
  "version": "1.1.1",
  "description": "LuCI support for Android Modem",
  "scripts": {
    "build": "node build.mjs",
    "build:package": "bun run build && ./.github/tools/build-package.sh",
    "livebuildtest": "bun run build && sshpass -p 'jancok123' scp -r dist/htdocs/luci-static/resources/* root@100.104.137.1:/www/luci-static/resources/ && npm run test:e2e",
    "version-bump": "./.github/tools/version-bump.sh",
    "watch": "tsc --watch",
    "dev": "tsc --watch",
    "tc": "bun x tsc --noEmit --strict",
    "fmt": "bun run tc && prettier --write .",
    "test:e2e": "npx playwright test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@kuoruan/luci-types": "^1.1.2",
    "@playwright/test": "^1.56.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/node": "^24.8.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
