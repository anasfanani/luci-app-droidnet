config droidnet 'device'
	option display_app '100'
	option display_msg '10'

config droidnet 'monitoring'
	option enable '0'
	option ping 'http'
	option host 'google.com'
	option success_limit '5'
	option failure_limit '3'
	option wait_time '3'
	option interface 'wan'
	option restart '0'
	option tunnel_service 'tunnel'

config droidnet 'httping'
	option enable '1'
	option http_url 'http://104.17.3.81/cdn-cgi/trace'
	option http_timeout '4'
	option http_status_expected '200'
	option http_max_retries '5'
	option http_delay_success '7'
	option http_delay_failed '0'
	option change_ip_delay '1'
	option change_ip_check_delay '1'
	option change_ip_check_max_retries '10'
	option force_ping '1'
	option deep_failed_trigger '25'
	option deep_failed_sleep_time '60'