{
  "luci-app-droidnet": {
    "description": "Grant access to luci-app-droidnet",
    "read": {
      "cgi-io": ["exec"],
      "file": {
        "/usr/bin/adb": ["exec"],
        "/usr/bin/env": ["exec"],
        "/usr/bin/tail": ["exec"],
        "/usr/bin/wget": ["exec"],
        "/bin/mkdir": ["exec"],
        "/usr/share/droidnet/httping": ["exec"],
        "/var/log/droidnet.log": ["read"]
      },
      "uci": ["droidnet"]
    },
    "write": {
      "file": {
        "/var/log/droidnet.log": ["write"],
        "/tmp/upload.apk": ["write"]
      },
      "uci": ["droidnet"]
    }
  }
}
